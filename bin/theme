#!/usr/bin/env bash

# Switch the color theme of Kitty, tmux, and Neovim in one step.
#
# Themes are described by the palette files in .config/themes. Applying one
# writes the generated Kitty, tmux, and Neovim fragments below STATE_DIR and
# reloads every running application in place.

set -Eeuo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF
readonly DOTFILES_DIR="$(dirname -- "$(dirname -- "$SELF")")"
readonly THEME_DIRS=(
	"${XDG_CONFIG_HOME:-$HOME/.config}/themes"
	"$DOTFILES_DIR/.config/themes"
)
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
# Kitty only supports include paths relative to its own config directory.
readonly KITTY_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/theme.conf"
readonly DEFAULT_THEME="catppuccin-mocha"

usage() {
	cat <<EOF
Usage: theme [command] [theme]

Commands:
  (none), pick     Choose a theme interactively
  list [--raw]     List the available themes
  current          Print the active theme
  set <theme>      Apply and remember a theme
  next, prev       Apply the next or previous theme in the list
  reload           Re-apply the active theme
  swatch <theme>   Print a color preview of a theme
  -h, --help       Show this help

Applying a theme updates Kitty, tmux, and Neovim, including sessions that are
already running.
EOF
}

die() {
	printf 'theme: %s\n' "$*" >&2
	exit 1
}

# Path of a theme's palette file. A file in ~/.config/themes overrides the
# tracked file of the same name.
theme_file() {
	local id="$1" dir

	for dir in "${THEME_DIRS[@]}"; do
		if [[ -f "$dir/$id.theme" ]]; then
			printf '%s\n' "$dir/$id.theme"
			return 0
		fi
	done
	return 1
}

list_ids() {
	local dir file
	for dir in "${THEME_DIRS[@]}"; do
		[[ -d "$dir" ]] || continue
		for file in "$dir"/*.theme; do
			[[ -f "$file" ]] || continue
			basename -- "$file" .theme
		done
	done | sort -u
}

# Read a palette file into the variables used by the writers below.
load_theme() {
	local id="$1" file

	file="$(theme_file "$id")" || die "unknown theme: $id (try 'theme list')"

	name=""
	appearance="dark"
	nvim_colorscheme=""
	nvim_plugin=""
	foreground=""
	background=""
	selection_foreground=""
	selection_background=""
	cursor=""
	palette=()

	# shellcheck disable=SC1090 # palette files are data, resolved at runtime
	source "$file"

	[[ -n "$nvim_colorscheme" ]] || die "$file: nvim_colorscheme is missing"
	[[ ${#palette[@]} -eq 16 ]] || die "$file: palette needs 16 colors, found ${#palette[@]}"
	: "${name:=$id}"
}

current_theme() {
	local id=""

	[[ -f "$STATE_DIR/current" ]] && read -r id <"$STATE_DIR/current"
	if [[ -z "$id" ]] || ! theme_file "$id" >/dev/null; then
		id="$DEFAULT_THEME"
	fi
	printf '%s\n' "$id"
}

# Replace a generated file in one step so a reader never sees a partial theme.
write_file() {
	local target="$1"

	cat >"$target.new"
	mv -f -- "$target.new" "$target"
}

write_kitty() {
	local index

	[[ -d "$(dirname -- "$KITTY_THEME")" ]] || return 0

	{
		printf '# Generated by `theme set %s`. Do not edit.\n\n' "$1"
		printf 'foreground %s\n' "$foreground"
		printf 'background %s\n' "$background"
		printf 'selection_foreground %s\n' "$selection_foreground"
		printf 'selection_background %s\n' "$selection_background"
		printf 'cursor %s\n' "$cursor"
		printf 'cursor_text_color background\n'
		printf 'url_color %s\n' "${palette[4]}"
		printf 'active_border_color %s\n' "${palette[4]}"
		printf 'inactive_border_color %s\n' "${palette[8]}"
		printf 'bell_border_color %s\n' "${palette[3]}"
		for index in "${!palette[@]}"; do
			printf 'color%d %s\n' "$index" "${palette[index]}"
		done
	} | write_file "$KITTY_THEME"
}

write_tmux() {
	{
		printf '# Generated by `theme set %s`. Do not edit.\n\n' "$1"
		printf 'set -g status-style "bg=%s,fg=%s"\n' "$background" "$foreground"
		# Inverted, so messages stay readable under light and dark palettes.
		printf 'set -g message-style "bg=%s,fg=%s"\n' "$foreground" "$background"
		printf 'set -g mode-style "bg=%s,fg=%s"\n' "$selection_background" "$selection_foreground"
		printf 'set -g pane-border-style "fg=%s"\n' "${palette[8]}"
		printf 'set -g pane-active-border-style "fg=%s"\n' "${palette[4]}"
		printf "set -g status-left  '#[fg=%s]#H #[default]'\n" "${palette[2]}"
		printf "set -g status-right '#[fg=%s]%%Y-%%m-%%d #[fg=%s]%%H:%%M:%%S '\n" \
			"${palette[4]}" "${palette[3]}"
	} | write_file "$STATE_DIR/tmux.conf"
}

write_nvim() {
	{
		printf -- '-- Generated by `theme set %s`. Do not edit.\n\n' "$1"
		printf 'return {\n'
		printf '\tid = "%s",\n' "$1"
		printf '\tname = "%s",\n' "$name"
		printf '\tappearance = "%s",\n' "$appearance"
		printf '\tcolorscheme = "%s",\n' "$nvim_colorscheme"
		printf '\tplugin = "%s",\n' "$nvim_plugin"
		# Neovim renders transparently, so this is the color behind its text.
		printf '\tbackground = "%s",\n' "$background"
		printf '}\n'
	} | write_file "$STATE_DIR/nvim.lua"
}

# Kitty reads colors once at startup, so running windows are updated over the
# remote control socket instead.
reload_kitty() {
	local kitty_remote socket applied=false

	if command -v kitten >/dev/null 2>&1; then
		kitty_remote=(kitten @)
	elif [[ -x "$HOME/.local/kitty.app/bin/kitten" ]]; then
		kitty_remote=("$HOME/.local/kitty.app/bin/kitten" @)
	else
		return 0
	fi

	[[ -f "$KITTY_THEME" ]] || return 0

	for socket in /tmp/kitty-*; do
		[[ -S "$socket" ]] || continue
		if "${kitty_remote[@]}" --to "unix:$socket" set-colors --all --configured \
			"$KITTY_THEME" >/dev/null 2>&1; then
			applied=true
		fi
	done

	if [[ "$applied" == false && -n "${KITTY_PID:-}" ]]; then
		printf 'Kitty could not be reloaded; restart it to pick up the theme.\n'
	fi
}

reload_tmux() {
	command -v tmux >/dev/null 2>&1 || return 0
	tmux info >/dev/null 2>&1 || return 0
	tmux source-file "$STATE_DIR/tmux.conf" >/dev/null 2>&1 || true
}

# Running Neovim instances watch STATE_DIR and reload themselves.
apply_theme() {
	local id="$1"

	load_theme "$id"
	mkdir -p "$STATE_DIR"
	write_kitty "$id"
	write_tmux "$id"
	write_nvim "$id"
	printf '%s\n' "$id" | write_file "$STATE_DIR/current"

	reload_kitty
	reload_tmux
}

swatch() {
	local id="$1" index rgb

	load_theme "$id"
	printf '%s (%s)\n\n' "$name" "$appearance"

	for index in "${!palette[@]}"; do
		rgb="${palette[index]#\#}"
		printf '\033[48;2;%d;%d;%dm    \033[0m' \
			"$((16#${rgb:0:2}))" "$((16#${rgb:2:2}))" "$((16#${rgb:4:2}))"
		[[ $((index % 8)) -eq 7 ]] && printf '\n'
	done

	rgb="${background#\#}"
	printf '\n\033[48;2;%d;%d;%dm' "$((16#${rgb:0:2}))" "$((16#${rgb:2:2}))" "$((16#${rgb:4:2}))"
	rgb="${foreground#\#}"
	printf '\033[38;2;%d;%d;%dm  %s  \033[0m\n' \
		"$((16#${rgb:0:2}))" "$((16#${rgb:2:2}))" "$((16#${rgb:4:2}))" "$id"
}

# Tab-separated fields for other programs to parse:
# id, name, appearance, Neovim color scheme, Neovim plugin, background.
raw_list() {
	local id

	while read -r id; do
		load_theme "$id"
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$id" "$name" "$appearance" "$nvim_colorscheme" "$nvim_plugin" "$background"
	done < <(list_ids)
}

list_themes() {
	local id current marker

	current="$(current_theme)"
	while read -r id; do
		load_theme "$id"
		marker=""
		[[ "$id" == "$current" ]] && marker="  <- current"
		printf '%s\t%-20s %-6s%s\n' "$id" "$name" "$appearance" "$marker"
	done < <(list_ids)
}

# Interactive picker. Themes are applied while browsing and the original theme
# is restored when the picker is cancelled.
pick_theme() {
	local original selection status=0 list

	original="$(current_theme)"

	if command -v fzf >/dev/null 2>&1; then
		# The list is built up front so the exit status belongs to fzf alone:
		# piping into it reports a broken pipe when it closes stdin on accept.
		list="$(list_themes)"
		selection="$(fzf \
			--ansi \
			--delimiter='\t' \
			--with-nth=2 \
			--layout=reverse \
			--height='60%' \
			--prompt='theme > ' \
			--header='enter applies, esc restores' \
			--preview="'$SELF' swatch {1}" \
			--preview-window='down,9' \
			--bind="focus:execute-silent('$SELF' set {1})" \
			<<<"$list")" || status=$?
	else
		local -a ids=()
		mapfile -t ids < <(list_ids)
		PS3='Theme: '
		select selection in "${ids[@]}"; do
			break
		done
		status=0
	fi

	if [[ $status -ne 0 || -z "${selection:-}" ]]; then
		apply_theme "$original"
		printf 'Kept %s.\n' "$original"
		return 0
	fi

	set_theme "${selection%%$'\t'*}"
}

set_theme() {
	apply_theme "$1"
	printf 'Applied %s.\n' "$name"
}

main() {
	local -a ids=()
	local current index

	case "${1:-pick}" in
		pick)
			pick_theme
			;;
		list)
			if [[ "${2:-}" == "--raw" ]]; then
				raw_list
			else
				list_themes | cut -f 2-
			fi
			;;
		current)
			current_theme
			;;
		set | apply)
			[[ $# -ge 2 ]] || die "set requires a theme name (try 'theme list')"
			apply_theme "$2"
			;;
		next | prev)
			mapfile -t ids < <(list_ids)
			current="$(current_theme)"
			for index in "${!ids[@]}"; do
				[[ "${ids[index]}" == "$current" ]] || continue
				if [[ "$1" == next ]]; then
					index=$(((index + 1) % ${#ids[@]}))
				else
					index=$(((index - 1 + ${#ids[@]}) % ${#ids[@]}))
				fi
				set_theme "${ids[index]}"
				return 0
			done
			set_theme "${ids[0]}"
			;;
		reload)
			apply_theme "$(current_theme)"
			;;
		swatch)
			[[ $# -ge 2 ]] || die "swatch requires a theme name"
			swatch "$2"
			;;
		-h | --help)
			usage
			;;
		*)
			if theme_file "$1" >/dev/null; then
				set_theme "$1"
			else
				printf 'Unknown command: %s\n\n' "$1" >&2
				usage >&2
				exit 2
			fi
			;;
	esac
}

main "$@"
